{
  "info": {
    "_postman_id": "6f0f0d1e-8f7a-4f0c-9b3e-2a1d5c7e9b41",
    "name": "Begento — API de Productos",
    "description": "Colección de la API RESTful de productos y precios por divisa.\n\nBase URL: `{{base_url}}/api/v1`\n\nDocumentación Swagger: `{{base_url}}/api/documentation`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Productos",
      "item": [
        {
          "name": "Listar productos",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/products?search=&page=1&per_page=15&sort=created_at&direction=desc",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "products"],
              "query": [
                { "key": "search", "value": "", "description": "Filtra por nombre o descripción (máx. 120)" },
                { "key": "page", "value": "1", "description": "Página solicitada (>= 0)" },
                { "key": "per_page", "value": "15", "description": "Registros por página (1-100)" },
                { "key": "sort", "value": "created_at", "description": "name | price | created_at | updated_at" },
                { "key": "direction", "value": "desc", "description": "asc | desc" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('data es un arreglo', () => pm.expect(json.data).to.be.an('array'));",
                  "if (json.data && json.data.length > 0) {",
                  "  pm.collectionVariables.set('product_id', json.data[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear producto",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop Pro 14 {{$timestamp}}\",\n  \"description\": \"Portátil de 14 pulgadas\",\n  \"price\": 1500.50,\n  \"currency_id\": 1,\n  \"tax_cost\": 150.00,\n  \"manufacturing_cost\": 900.00\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/products",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "products"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('cabecera Location', () => pm.expect(pm.response.headers.has('Location')).to.be.true);",
                  "pm.collectionVariables.set('product_id', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Ver producto",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/products/{{product_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "products", "{{product_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('incluye divisa', () => pm.expect(pm.response.json().data.currency).to.be.an('object'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar producto",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop Pro 15 {{$timestamp}}\",\n  \"description\": \"Portátil de 15 pulgadas\",\n  \"price\": 1700.00,\n  \"currency_id\": 1,\n  \"tax_cost\": 170.00,\n  \"manufacturing_cost\": 1000.00\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/products/{{product_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "products", "{{product_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('precio actualizado', () => pm.expect(pm.response.json().data.price).to.eql('1700.00'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar producto",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/products/{{product_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "products", "{{product_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Precios",
      "item": [
        {
          "name": "Listar precios del producto",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/products/{{product_id}}/prices?page=1&per_page=15&sort=-created_at",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "products", "{{product_id}}", "prices"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "15", "description": "1-100" },
                { "key": "sort", "value": "-created_at", "description": "price | created_at | id, con prefijo - para descendente" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('incluye divisa base', () => pm.expect(pm.response.json().meta).to.have.property('base_currency_id'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar precio",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currency_id\": 2,\n  \"price\": 1422.10\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/products/{{product_id}}/prices",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "products", "{{product_id}}", "prices"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('cabecera Location', () => pm.expect(pm.response.headers.has('Location')).to.be.true);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Errores",
      "item": [
        {
          "name": "Producto inexistente (404)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/products/999999",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "products", "999999"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Validación fallida (422)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"description\": \"\",\n  \"price\": -5,\n  \"currency_id\": 1,\n  \"manufacturing_cost\": 100\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/products",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "products"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 Unprocessable Content', () => pm.response.to.have.status(422));",
                  "pm.test('trae errores por campo', () => pm.expect(pm.response.json()).to.have.property('errors'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Content-Type no soportado (415)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "text/plain" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "name=invalido"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/products",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "products"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('415 Unsupported Media Type', () => pm.response.to.have.status(415));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "product_id",
      "value": "1",
      "type": "string"
    }
  ]
}
